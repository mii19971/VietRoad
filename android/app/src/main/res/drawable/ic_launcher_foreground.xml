<?xml version="1.0" encoding="utf-8"?>
<!--
  Lop TRUOC cua adaptive icon (108 x 108 dp).
  Chi phan giua (vong tron ban kinh 33 quanh tam 54,54 = "vung an toan") chac chan hien thi;
  phan ngoai co the bi cat. Vi vay bien bao co ban kinh 30.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vien do cua bien bao: hinh tron ban kinh 30 (ve bang 2 nua cung tron) -->
    <path
        android:fillColor="@color/sign_red"
        android:pathData="M24,54 a30,30 0 1,1 60,0 a30,30 0 1,1 -60,0 Z" />

    <!-- Long trang cua bien bao: ban kinh 23 -->
    <path
        android:fillColor="@color/sign_white"
        android:pathData="M31,54 a23,23 0 1,1 46,0 a23,23 0 1,1 -46,0 Z" />

    <!-- Than camera (chu nhat bo goc 2) -->
    <path
        android:fillColor="@color/camera_dark"
        android:pathData="M40,47 h22 a2,2 0 0 1 2,2 v12 a2,2 0 0 1 -2,2 h-22 a2,2 0 0 1 -2,-2 v-12 a2,2 0 0 1 2,-2 Z" />

    <!-- Phan dau quay (hinh thang ben phai) -->
    <path
        android:fillColor="@color/camera_dark"
        android:pathData="M64,51 L71,47 L71,63 L64,59 Z" />

    <!-- Ong kinh: vong trang + tam toi -->
    <path
        android:fillColor="@color/sign_white"
        android:pathData="M45,55 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0 Z" />
    <path
        android:fillColor="@color/camera_dark"
        android:pathData="M47.5,55 a2.5,2.5 0 1,1 5,0 a2.5,2.5 0 1,1 -5,0 Z" />

    <!-- Den bao do tren camera -->
    <path
        android:fillColor="@color/sign_red"
        android:pathData="M58,51 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0 Z" />
</vector>
