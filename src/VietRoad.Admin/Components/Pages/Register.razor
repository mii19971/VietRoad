@page "/register"
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Đăng ký - VietRoad Admin</PageTitle>

<div style="max-width: 420px">
    <h1 class="h3 mb-3">Đăng ký</h1>

    @if (needsFirstAdmin)
    {
        <div class="alert alert-info">
            Hệ thống <strong>chưa có quản trị viên</strong>. Tài khoản bạn tạo bây giờ sẽ là
            <strong>admin đầu tiên</strong> và được đăng nhập ngay.
        </div>
    }
    else if (!done)
    {
        <div class="alert alert-secondary">
            Tài khoản mới là tài khoản thường. Để vào trang quản trị, hãy nhờ một admin
            cấp quyền ở mục <em>Người dùng</em>.
        </div>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (done)
    {
        <div class="alert alert-success">
            Đã tạo tài khoản <strong>@Input.Email</strong>. Hãy nhờ admin cấp quyền, sau đó
            <a href="login">đăng nhập</a>.
        </div>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tên hiển thị (không bắt buộc)</label>
                <InputText @bind-Value="Input.DisplayName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu (ít nhất 8 ký tự)</label>
                <InputText @bind-Value="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Password" />
            </div>
            <div class="mb-3">
                <label class="form-label">Nhập lại mật khẩu</label>
                <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
            <button type="submit" class="btn btn-primary w-100">
                @(needsFirstAdmin ? "Tạo admin đầu tiên" : "Đăng ký")
            </button>
        </EditForm>

        <p class="mt-3 text-center">Đã có tài khoản? <a href="login">Đăng nhập</a></p>
    }
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private RegisterInput Input { get; set; } = new();

    private bool needsFirstAdmin;
    private bool done;
    private string? error;

    // Hoi API moi lan mo trang (ca GET lan POST): da co admin chua.
    protected override async Task OnInitializedAsync() =>
        needsFirstAdmin = await Api.NeedsFirstAdminAsync();

    private async Task RegisterAsync()
    {
        var result = await Api.RegisterAsync(Input.Email, Input.Password, Input.DisplayName, asFirstAdmin: needsFirstAdmin);
        if (!result.Ok)
        {
            error = result.Error;
            return;
        }

        if (result.Value!.User.Role == "admin")
        {
            // Admin dau tien: dang nhap luon roi vao trang Tong quan.
            await AdminSignIn.SignInAsync(HttpContext, result.Value);
            Nav.NavigateTo("/");
            return;
        }

        done = true;
    }

    private sealed class RegisterInput
    {
        [Required(ErrorMessage = "Nhập email")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = "";

        [StringLength(100, ErrorMessage = "Tối đa 100 ký tự")]
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Nhập mật khẩu")]
        [StringLength(128, MinimumLength = 8, ErrorMessage = "Mật khẩu 8-128 ký tự")]
        public string Password { get; set; } = "";

        // [Compare]: kiem tra 2 o mat khau giong nhau ngay tren server truoc khi goi API.
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu nhập lại không khớp")]
        public string ConfirmPassword { get; set; } = "";
    }
}
