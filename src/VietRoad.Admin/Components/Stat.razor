@* O thong ke nho. Dung: <Stat Title="..." Value="123" Href="reports" /> *@
<div class="col-6 col-md-3">
    <div class="card h-100 @(Highlight ? "border-warning" : "")">
        <div class="card-body">
            <div class="text-muted small">@Title</div>
            <div class="fs-3 fw-semibold">
                @if (Href is null) { @Value } else { <a href="@Href" class="text-decoration-none">@Value</a> }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public int Value { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Highlight { get; set; }
}
